# ─────────────────────────────────────────────────────────────────────────────
# Fronda 1.0 — Variables de Entorno Disponibles
# Copia este archivo como .env y rellena los valores que quieras sobreescribir.
# Las variables de entorno tienen prioridad sobre config.json.
# ─────────────────────────────────────────────────────────────────────────────

# URL de Ollama (local o remoto)
# FRONDA_OLLAMA_URL=http://127.0.0.1:11434

# Modelo principal de Ollama a usar
# FRONDA_MODEL=frondabrick

# Modelo de fallback si el principal falla
# FRONDA_FALLBACK_MODEL=qwen2.5-coder:1.5b

# Timeout en segundos para las llamadas a Ollama
# FRONDA_TIMEOUT=120

# Puerto del servidor HTTP de Fronda
# FRONDA_PORT=5176

# Host de escucha del servidor (0.0.0.0 = todas las interfaces)
# FRONDA_HOST=0.0.0.0

# Token de autenticación (vacío = sin autenticación)
# FRONDA_AUTH_TOKEN=mi_token_secreto

# Voz TTS de Edge-TTS (ver lista en: edge-tts --list-voices)
# FRONDA_VOICE=es-ES-AlvaroNeural

# Nombre de la distro WSL (vacío = auto-detección)
# FRONDA_WSL_DISTRO=Ubuntu

# Nombre completo del usuario (creador de Fronda)
# FRONDA_USER_NAME=David Galleguillos

# Nickname del usuario para respuestas informales
# FRONDA_USER_NICKNAME=David

# Número de threads de CPU (0 = auto-detectar)
# FRONDA_CPU_THREADS=0
